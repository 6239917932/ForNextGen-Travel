DATABASE_URL="file:./prisma/dev.db"
# Production migrations use a direct TLS PostgreSQL connection supplied by the secret manager.
DIRECT_DATABASE_URL=""
DATABASE_PLATFORM_PROVIDER=""
DATABASE_PLATFORM_REGION=""
DATABASE_HIGH_AVAILABILITY="false"
DATABASE_PITR_ENABLED="false"
DATABASE_BACKUP_POLICY_ID=""
DATABASE_CUTOVER_PLAN_ID=""
DATABASE_RESTORE_EVIDENCE_ID=""
DATABASE_POOL_MAX="10"
DATABASE_CONNECT_TIMEOUT_MS="10000"
DATABASE_STATEMENT_TIMEOUT_MS="30000"
PUBLIC_APP_ORIGIN="http://localhost:3000"
# Explicit opt-in for an approved public release; set at build and runtime.
PUBLIC_INDEXING_ENABLED="false"
# Local preview fixtures are enabled by default outside production. Production always ignores them.
FIXTURE_INVENTORY_ENABLED="true"
BOOKING_TOKEN_SECRET="replace-with-a-long-random-secret"
# Dedicated server-side key used to hash email OTP challenges and supplier acceptance evidence.
# Keep the real value only in the deployment secret manager and use at least 32 random characters.
SESSION_SECRET="replace-with-a-different-long-random-secret"
MFA_ENCRYPTION_KEY="base64-encoded-32-byte-key"
MEDIA_SIGNING_ENDPOINT="https://storage-signer.example.com/v1/upload-intents"
MEDIA_SIGNING_API_KEY="replace-with-storage-signing-service-key"
MEDIA_PROVIDER_ALLOWED_HOSTS="storage-signer.example.com,uploads.example.com,cdn.example.com"
# KYC evidence uses a separate private-only signer/scanner contract. Never reuse public media keys.
KYC_DOCUMENT_SIGNING_ENDPOINT=""
KYC_DOCUMENT_SIGNING_API_KEY=""
KYC_DOCUMENT_PROVIDER_ALLOWED_HOSTS=""
KYC_DOCUMENT_SCAN_CALLBACK_SECRET=""
PAYMENT_GATEWAY_MODE="sandbox"
PAYMENT_PROVIDER_ID="razorpay"
PAYMENT_PROVIDER_ALLOWED_HOSTS="api.razorpay.com,checkout.razorpay.com"
# Razorpay Orders and Checkout. Store real production values only in the deployment secret manager.
RAZORPAY_INTEGRATION_ENABLED="false"
RAZORPAY_ROUTE_ENABLED="false"
RAZORPAY_ROUTE_APPROVAL_REFERENCE=""
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Generic fallback adapter. Not used when PAYMENT_PROVIDER_ID=razorpay.
PAYMENT_GATEWAY_ENDPOINT=""
PAYMENT_GATEWAY_API_KEY=""
PAYMENT_WEBHOOK_SECRET=""
PAYMENT_GATEWAY_REFUND_ENDPOINT=""
# Demo transport checkout is opt-in and is always rejected in production.
ALLOW_DEMO_TRANSPORT_CHECKOUT="false"
# Optional startup-tier flight search. Disabled by default. Create server credentials at
# developers.amadeus.com; never expose the secret to the browser or commit a real value.
# The test environment is rejected when NODE_ENV=production and its results are never labelled live.
AMADEUS_FLIGHT_ENABLED="false"
AMADEUS_ENVIRONMENT="test"
AMADEUS_CLIENT_ID=""
AMADEUS_CLIENT_SECRET=""
# Hotelbeds/HBX evaluation access is administrator-only until certification and a commercial
# agreement are complete. Keep both values in the server secret store. Evaluation is rejected in
# production and is never exposed as customer-bookable inventory.
HOTELBEDS_ENABLED="false"
HOTELBEDS_ENVIRONMENT="evaluation"
HOTELBEDS_API_KEY=""
HOTELBEDS_SECRET=""
# Base64-encoded PEM values. Generate the key/CSR securely, create the certificate in the HBX
# developer portal, and associate it with this API key. Never commit PEM files or decoded values.
HOTELBEDS_MTLS_CERT_BASE64=""
HOTELBEDS_MTLS_KEY_BASE64=""
HOTELBEDS_MTLS_CA_BASE64=""
# Content synchronization is separately gated and must run only as an authenticated scheduled batch.
# It is never called from customer search. Keep disabled until HBX approves the evaluation run.
HOTELBEDS_CONTENT_SYNC_ENABLED="false"
HOTELBEDS_CONTENT_LANGUAGE="ENG"
HOTELBEDS_CONTENT_MAX_PAGES_PER_RUN="1"
# Provider adapters sign short-lived flight, bus, and car payment evidence with this secret.
TRANSPORT_PAYMENT_EVIDENCE_SECRET="replace-with-a-long-random-transport-payment-secret"
# Payout accounts must be tokenized by the payout provider. Never store raw account numbers here.
PAYOUT_PROVIDER_ID="configured-payout-provider"
PAYOUT_PROVIDER_ENDPOINT="https://payouts.example.com/v1/batches"
PAYOUT_PROVIDER_API_KEY="replace-with-payout-provider-key"
PAYOUT_PROVIDER_ALLOWED_HOSTS="payouts.example.com"
EMAIL_PROVIDER_ENDPOINT="https://messaging.example.com/v1/email"
EMAIL_PROVIDER_API_KEY="replace-with-email-provider-key"
EMAIL_PROVIDER_ALLOWED_HOSTS="messaging.example.com"
EMAIL_FROM_ADDRESS="bookings@mandyaltravels.example"
# SMTP alternative for mailbox providers such as Titan. Store the password only in the deployment
# secret manager. Only implicit TLS on port 465 is accepted.
EMAIL_SMTP_HOST=""
EMAIL_SMTP_PORT="465"
EMAIL_SMTP_USER=""
EMAIL_SMTP_PASSWORD=""
EMAIL_SMTP_ALLOWED_HOSTS=""
EMAIL_BOUNCE_WEBHOOK_SECRET="replace-with-at-least-32-random-characters"
EMAIL_SUPPRESSION_HASH_SECRET="replace-with-a-separate-32-character-random-secret"
# Turn on only after a real email provider has passed delivery testing.
AUTH_EMAIL_OTP_REQUIRED="false"
MOBILE_MESSAGING_ENDPOINT="https://messaging.example.com/v1/messages"
MOBILE_MESSAGING_API_KEY="replace-with-sms-whatsapp-provider-key"
MOBILE_MESSAGING_ALLOWED_HOSTS="messaging.example.com"
SMS_SENDER_ID="MANDYL"
WHATSAPP_SENDER="replace-with-approved-whatsapp-sender"
PUSH_PROVIDER_ENDPOINT="https://push.example.com/v1/messages"
PUSH_PROVIDER_API_KEY="replace-with-push-provider-key"
PUSH_PROVIDER_ALLOWED_HOSTS="push.example.com"
INTEGRATION_OUTBOX_ENDPOINT="https://channels.example.com/v1/events"
INTEGRATION_OUTBOX_API_KEY="replace-with-integration-provider-key"
INTEGRATION_OUTBOX_ALLOWED_HOSTS="channels.example.com"
INTEGRATION_OUTBOX_WORKER_SECRET="replace-with-a-different-at-least-32-character-secret"
INTEGRATION_OUTBOX_WORKER_BATCH_SIZE="25"
INTEGRATION_OUTBOX_WORKER_TIMEOUT_MS="300000"
INTEGRATION_OUTBOX_WORKER_LEASE_SECONDS="300"
NOTIFICATION_WORKER_SECRET="replace-with-at-least-32-random-characters"
NOTIFICATION_WORKER_BATCH_SIZE="25"
NOTIFICATION_WORKER_TIMEOUT_MS="30000"
NOTIFICATION_WORKER_LEASE_SECONDS="120"
AUTOPILOT_WORKER_SECRET="replace-with-a-different-at-least-32-character-secret"
AUTOPILOT_WORKER_BATCH_SIZE="25"
AUTOPILOT_WORKER_TIMEOUT_MS="30000"
AUTOPILOT_WORKER_LEASE_SECONDS="120"
SEARCH_PROJECTION_SOURCE_LIMIT="5000"
SEARCH_PROJECTION_WORKER_TIMEOUT_MS="120000"
SEARCH_PROJECTION_WORKER_LEASE_SECONDS="300"
RECOVERY_EVIDENCE_REPORT_ORIGIN=""
RECOVERY_EVIDENCE_REPORT_TIMEOUT_MS="30000"
PARTNER_ADMIN_KEY="replace-with-a-long-random-admin-key"
DATABASE_BACKUP_DIRECTORY="backups"
DATABASE_BACKUP_RETENTION="14"
# Server-to-server partner API calls must also send the supplier's x-partner-id header.
