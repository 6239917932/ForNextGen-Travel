# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/.npm-cache/
/.npm-task-cache/
/.gh-task-cache/

# local database
/prisma/dev.db
/prisma/dev.db-journal
/prisma/ota-preview.db*
/prisma/ota-preview-independent.db*
/prisma/*-e2e.db
/prisma/backups/
/backups/

# env files (can opt-in for committing if needed)
.env*
!.env.example

# generated database client
/generated/prisma/
/generated/prisma-postgresql/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
