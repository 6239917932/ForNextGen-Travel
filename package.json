{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test:domain": "node --experimental-strip-types --test tests/*.test.mts",
    "test:hotel": "npm run test:domain",
    "test:smoke": "node scripts/smoke-portal.mjs",
    "test:a11y": "node scripts/verify-accessibility.mjs",
    "test:links": "node scripts/verify-internal-links.mjs",
    "test:load": "node scripts/load-smoke.mjs",
    "test:runtime": "npm run test:smoke && npm run test:a11y && npm run test:links && npm run test:load",
    "monitor:production": "node scripts/monitor-production.mjs",
    "worker:notifications": "node scripts/run-notification-worker.mjs",
    "worker:integration-outbox": "node scripts/run-integration-outbox-worker.mjs",
    "worker:maintenance": "node scripts/run-maintenance-worker.mjs",
    "worker:search-projections": "node scripts/run-search-projection-worker.mjs",
    "worker:hotelbeds-content": "node scripts/run-hotelbeds-content-worker.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run api:verify-contract && npm run routes:verify-static && npm run test:domain && npm run db:verify-migrations && npm run db:verify:postgresql && npm run deployment:verify && npm run launch:verify-register && npm run build -- --webpack",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "api:verify-contract": "node --experimental-strip-types scripts/verify-api-v1-contract.mjs",
    "api:write-contract": "node --experimental-strip-types scripts/verify-api-v1-contract.mjs --write",
    "routes:verify-static": "node scripts/verify-static-internal-routes.mjs",
    "admin:grant": "node scripts/grant-platform-admin.mjs",
    "partner:grant": "node scripts/grant-hotel-partner.mjs",
    "db:generate": "node scripts/generate-prisma-clients.mjs",
    "db:sync:postgresql": "node scripts/sync-postgresql-contract.mjs",
    "db:verify:postgresql": "node scripts/sync-postgresql-contract.mjs --check",
    "db:verify:postgresql:live": "node scripts/verify-live-postgresql-schema.mjs",
    "db:deploy:postgresql": "prisma migrate deploy --config prisma.postgresql.config.ts",
    "db:rehearse:postgresql": "node scripts/rehearse-postgresql-cutover.mjs",
    "db:repair-finance-migration": "node scripts/repair-failed-finance-migration.mjs",
    "db:verify-migrations": "node scripts/verify-migrations.mjs",
    "db:deploy": "prisma migrate deploy",
    "db:migrate": "prisma migrate dev",
    "db:backup": "node scripts/backup-database.mjs",
    "db:verify-backup": "node scripts/verify-backup-restore.mjs",
    "deployment:verify": "node scripts/verify-deployment-contract.mjs",
    "launch:verify-register": "node --experimental-strip-types scripts/verify-launch-readiness.mjs",
    "release:verify-env": "node scripts/verify-release-env.mjs",
    "supplier:verify:hotelbeds": "node --experimental-strip-types scripts/verify-hotelbeds-evaluation.mjs",
    "postinstall": "node scripts/generate-prisma-clients.mjs"
  },
  "dependencies": {
    "@prisma/adapter-better-sqlite3": "^7.10.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/qrcode": "^1.5.6",
    "dotenv": "^17.4.2",
    "next": "16.3.8",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "overrides": {
    "deepmerge-ts": "8.0.1",
    "fast-uri": "3.1.6",
    "js-yaml": "4.3.2",
    "mysql2": "3.24.3",
    "nanoid": "3.3.18"
  }
}
